<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CopyCop.Gui.ViewModels"
        x:Class="CopyCop.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CopyCop"
        Icon="/Assets/copycop.ico"
        Width="1180" Height="790"
        MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#090E1B">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111A2C" />
      <Setter Property="BorderBrush" Value="#23304A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="Border.softCard">
      <Setter Property="Background" Value="#0D1525" />
      <Setter Property="BorderBrush" Value="#1D2A43" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="15" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#7888A8" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8D9AB5" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#5B7CFA" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#18243A" />
      <Setter Property="Foreground" Value="#DCE6FA" />
      <Setter Property="BorderBrush" Value="#2A3A59" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.editor">
      <Setter Property="Background" Value="#0B1220" />
      <Setter Property="Foreground" Value="#EAF0FC" />
      <Setter Property="BorderBrush" Value="#253552" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="SelectionBrush" Value="#526DD0" />
    </Style>
    <Style Selector="ProgressBar.capacity">
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#1C2940" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Background" Value="#18243A" />
      <Setter Property="BorderBrush" Value="#344767" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#DCE6FA" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="28" RowSpacing="18">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <Image Width="48" Height="48" Source="/Assets/copycop-logo.png"
             Stretch="Uniform" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="COPYCOP" Classes="eyebrow" />
        <TextBlock Text="Portable Zwischenablage" FontSize="22" FontWeight="SemiBold" />
      </StackPanel>
      <Border Grid.Column="2" Classes="softCard" Padding="15,10" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
          <Ellipse Width="9" Height="9" Fill="{Binding ConnectionBrush}"
                   VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="{Binding ConnectionText}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConnectionDetail}" FontSize="11" Classes="muted"
                       MaxWidth="360" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.65*,1*" ColumnSpacing="18">
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="TEXT" Classes="eyebrow" />
              <TextBlock Text="Zwischenablage prüfen" FontSize="19" FontWeight="SemiBold" />
            </StackPanel>
            <Button Grid.Column="1" Classes="secondary"
                    Command="{Binding PasteClipboardCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="↓" FontSize="17" />
                <TextBlock Text="Aus Zwischenablage" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBox Grid.Row="1" Classes="editor"
                   Text="{Binding Text, Mode=TwoWay}"
                   PlaceholderText="Text hier einfügen oder mit C direkt aus der Zwischenablage übernehmen …"
                   AcceptsReturn="True" AcceptsTab="True"
                   TextWrapping="Wrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding CharacterText}" Classes="muted" FontSize="12" />
            <TextBlock Grid.Column="1" Text="Deutsches QWERTZ · CRLF wird normalisiert"
                       Classes="muted" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding ByteText}" Classes="muted" FontSize="12" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="14">
        <TabControl Grid.Row="0">
          <TabItem Header="Analyse">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel Spacing="14">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="KAPAZITÄT" Classes="eyebrow" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding CapacityHeadline}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{Binding CapacityBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding RemainingText}" Classes="muted"
                           FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <ProgressBar Classes="capacity" Minimum="0" Maximum="100"
                           Value="{Binding UsagePercent}" Foreground="{Binding CapacityBrush}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CharacterText}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding ByteText}" Classes="muted" FontSize="12" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="softCard">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ZEICHENPRÜFUNG" Classes="eyebrow" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="Unbekannte durch ? ersetzen"
                          IsChecked="{Binding ReplaceUnsupported}" FontSize="11" />
              </Grid>
              <TextBlock Text="{Binding UnsupportedText}" TextWrapping="Wrap"
                         Foreground="{Binding CapacityBrush}" FontSize="12" LineHeight="18" />
            </StackPanel>
          </Border>

          <Border Classes="softCard">
            <StackPanel Spacing="7">
              <TextBlock Text="GESCHÄTZTE TIPPDAUER" Classes="eyebrow" />
              <TextBlock Text="{Binding TypingEstimateHint}" Classes="muted"
                         FontSize="11" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="7" RowSpacing="5">
                <Border Width="10" Height="10" CornerRadius="5" Background="#36D7D9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="5 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{Binding Duration5}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                <Border Grid.Column="3" Width="10" Height="10" CornerRadius="5" Background="#36D98B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="25 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Column="5" Text="{Binding Duration25}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />

                <Border Grid.Row="1" Width="10" Height="10" CornerRadius="5" Background="#63E66F" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="50 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Duration50}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                <Border Grid.Row="1" Grid.Column="3" Width="10" Height="10" CornerRadius="5" Background="#B8E64B" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="4" Text="100 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding Duration100}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />

                <Border Grid.Row="2" Width="10" Height="10" CornerRadius="5" Background="#E8D34E" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="250 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Duration250}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                <Border Grid.Row="2" Grid.Column="3" Width="10" Height="10" CornerRadius="5" Background="#F2A640" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="4" Text="500 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding Duration500}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />

                <Border Grid.Row="3" Width="10" Height="10" CornerRadius="5" Background="#F06B3D" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="750 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Duration750}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
                <Border Grid.Row="3" Grid.Column="3" Width="10" Height="10" CornerRadius="5" Background="#E84E57" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Grid.Column="4" Text="1000 ms" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Grid.Row="3" Grid.Column="5" Text="{Binding Duration1000}" Classes="muted" FontSize="12" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="softCard" IsVisible="{Binding NeedsSplit}">
            <StackPanel Spacing="11">
              <TextBlock Text="TEXT AUFTEILEN" Classes="eyebrow" />
              <TextBlock Text="{Binding SplitSummary}" FontSize="14" FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock Text="Unicode-sicher an Zeilen- oder Wortgrenzen. Auf dem Gerät wird jeweils nur der ausgewählte Teil gespeichert."
                         Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
              <Button Classes="secondary" Command="{Binding SplitCommand}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Automatisch aufteilen" />
              <ComboBox ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}"
                        IsVisible="{Binding HasParts}" PlaceholderText="Teil wählen" />
              <TextBlock Text="{Binding SelectedPartDetail}" IsVisible="{Binding HasParts}"
                         Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Bedienung &amp; LEDs">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
              <StackPanel Spacing="14">
                <Border Classes="softCard">
                  <StackPanel Spacing="13">
                    <TextBlock Text="MODUS BEIM EINSTECKEN" Classes="eyebrow" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Classes="keycap"><TextBlock Text="keine" FontSize="11" TextAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="Normalmodus" Classes="sectionTitle" />
                        <TextBlock Text="Grüne LED · reine USB-Tastatur" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Classes="keycap"><TextBlock Text="Strg" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="AFK-Modus" Classes="sectionTitle" />
                        <TextBlock Text="Nur Strg halten · violette LED" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Classes="keycap"><TextBlock Text="C" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="LOAD-Modus" Classes="sectionTitle" />
                        <TextBlock Text="C halten · blaue LED · GUI-Verbindung" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Classes="keycap"><TextBlock Text="alle 3" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" /></Border>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="Firmware-Update" Classes="sectionTitle" />
                        <TextBlock Text="Weiße LED · Laufwerk RPI-RP2" Classes="muted" FontSize="11" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="softCard">
                  <StackPanel Spacing="13">
                    <TextBlock Text="PHYSISCHE TASTEN" Classes="eyebrow" />
                    <TextBlock Text="Normalmodus · grün" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                      <TextBlock Text="Strg" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="langsamer · auch beim Tippen" Classes="muted" />
                      <TextBlock Grid.Row="1" Text="C" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="schneller · auch beim Tippen" Classes="muted" />
                      <TextBlock Grid.Row="2" Text="V" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="Text tippen · erneut drücken = Stopp" Classes="muted" TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Background="#253552" Margin="0,2" />
                    <TextBlock Text="LOAD-Modus · blau" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="60,*">
                      <TextBlock Text="C" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="Laptop-Zwischenablage übernehmen und speichern" Classes="muted" TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Background="#253552" Margin="0,2" />
                    <TextBlock Text="AFK-Modus · violett" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                      <TextBlock Text="C" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="Endloswiederholung starten" Classes="muted" />
                      <TextBlock Grid.Row="1" Text="V" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="sofort stoppen" Classes="muted" />
                      <TextBlock Grid.Row="2" Text="Strg+C" FontWeight="SemiBold" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="genau einmal mit Zufallsabständen" Classes="muted" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="Gemeint sind immer die drei Tasten auf CopyCop. C oder V auf dem Laptop lösen nichts aus."
                               Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                    <TextBlock Text="AltGr-Zeichen werden automatisch mit einem realistischen Tastentiming ausgegeben."
                               Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                  </StackPanel>
                </Border>

                <Border Classes="softCard">
                  <StackPanel Spacing="12">
                    <TextBlock Text="GESCHWINDIGKEIT &amp; FARBE" Classes="eyebrow" />
                    <TextBlock Text="C macht schneller · Strg macht langsamer" Classes="muted" FontSize="11" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="9" RowSpacing="10">
                      <Border Width="13" Height="13" CornerRadius="7" Background="#36D7D9" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="5 ms" FontWeight="SemiBold" />
                      <Border Grid.Column="2" Width="13" Height="13" CornerRadius="7" Background="#36D98B" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="25 ms" FontWeight="SemiBold" />

                      <Border Grid.Row="1" Width="13" Height="13" CornerRadius="7" Background="#63E66F" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="50 ms" FontWeight="SemiBold" />
                      <Border Grid.Row="1" Grid.Column="2" Width="13" Height="13" CornerRadius="7" Background="#B8E64B" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="3" Text="100 ms" FontWeight="SemiBold" />

                      <Border Grid.Row="2" Width="13" Height="13" CornerRadius="7" Background="#E8D34E" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="250 ms" FontWeight="SemiBold" />
                      <Border Grid.Row="2" Grid.Column="2" Width="13" Height="13" CornerRadius="7" Background="#F2A640" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Grid.Column="3" Text="500 ms" FontWeight="SemiBold" />

                      <Border Grid.Row="3" Width="13" Height="13" CornerRadius="7" Background="#F06B3D" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="750 ms" FontWeight="SemiBold" />
                      <Border Grid.Row="3" Grid.Column="2" Width="13" Height="13" CornerRadius="7" Background="#E84E57" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="3" Grid.Column="3" Text="1000 ms" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="Die Geräte-LED ist absichtlich dunkler als die Farbpunkte hier. Im AFK-Modus werden diese acht Zeiten zufällig verwendet."
                               Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                  </StackPanel>
                </Border>

                <Border Classes="softCard">
                  <StackPanel Spacing="11">
                    <TextBlock Text="WEITERE LED-SIGNALE" Classes="eyebrow" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
                      <Border Width="13" Height="13" CornerRadius="7" Background="#3DD6D0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="Cyan · Text wird gerade getippt" Classes="muted" />
                      <Border Grid.Row="1" Width="13" Height="13" CornerRadius="7" Background="#FFC66D" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="Orange · Übertragung läuft" Classes="muted" />
                      <Border Grid.Row="2" Width="13" Height="13" CornerRadius="7" Background="#63E6A5" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="Grün · erfolgreich gespeichert" Classes="muted" />
                      <Border Grid.Row="3" Width="13" Height="13" CornerRadius="7" Background="#FF5D73" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="Rot · Fehler oder kein Text" Classes="muted" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <Border Grid.Row="1" Classes="softCard">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="GERÄT" Classes="eyebrow" />
                <TextBlock Text="{Binding StoredText}" Classes="muted" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="126.464 B" FontSize="13" FontWeight="SemiBold"
                         Foreground="#70A5FF" VerticalAlignment="Center" />
            </Grid>
            <Button Classes="primary" Command="{Binding SendCommand}"
                    Content="{Binding SendButtonText}" />
            <Button Classes="secondary" Command="{Binding CancelCommand}"
                    Content="Übertragung abbrechen" IsVisible="{Binding IsBusy}" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#0D1525" BorderBrush="#1D2A43"
            BorderThickness="1" CornerRadius="13" Padding="15,11">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <Ellipse Width="8" Height="8" Fill="{Binding ActivityBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ActivityText}" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Hilfe: Bedienung &amp; LEDs"
                     Classes="muted" FontSize="11" />
        </Grid>
        <ProgressBar Grid.Row="1" IsVisible="{Binding ShowProgress}"
                     Minimum="0" Maximum="100" Value="{Binding TransferProgress}"
                     Height="4" CornerRadius="2" Background="#1C2940" Foreground="#63E6A5" />
      </Grid>
    </Border>
  </Grid>
</Window>
